+#if PAN_ARCH <= 7
+/*
+ * Scion: a subpass input that is a colour attachment of the same subpass, read at the fragment's own pixel, is
+ * read from the tile buffer (LD_TILE, as the blend shaders and OpenGL ES's framebuffer fetch do), not from memory.
+ * Bifrost orders a fragment's tile buffer accesses after the earlier fragments' at its pixel, so the read sees
+ * every earlier draw of the pass, the pass's clear included, with no barrier: the device offers
+ * rasterizationOrderColorAttachmentAccess. Through memory, each read needed a barrier first, which splits the job
+ * chain: the tiles of every earlier draw are written out, and loaded again for the next chain. metal2vulkan reads
+ * Metal's framebuffer fetch as such an input attachment, so CoreAnimation's window server split its frames 5 to
+ * 13 times each, the whole screen written and read back every time.
+ *
+ * Other input attachments (depth, stencil, another subpass's colours, multisampled ones, a pixel offset) are
+ * left to nir_lower_input_attachments, as before.
+ */
+struct tile_inputs {
+   const struct vk_input_attachment_location_state *ial;
+   const struct vk_render_pass_state *rp;
+   enum pipe_format formats[8]; /* the colour attachments read, PIPE_FORMAT_NONE for the others */
+};
+
+static bool
+lower_tile_input_attachment(nir_builder *b, nir_intrinsic_instr *intr,
+                            void *data)
+{
+   struct tile_inputs *ctx = data;
+
+   if (intr->intrinsic != nir_intrinsic_image_deref_load)
+      return false;
+
+   nir_deref_instr *deref = nir_src_as_deref(intr->src[0]);
+   enum glsl_sampler_dim dim = glsl_get_sampler_dim(deref->type);
+   if (dim != GLSL_SAMPLER_DIM_SUBPASS && dim != GLSL_SAMPLER_DIM_SUBPASS_MS)
+      return false;
+
+   /* A multisampled one at the invocation's own sample (metal2vulkan reads a
+    * multisampled pass's attachment so, under sample shading): the tile
+    * buffer's sample of this invocation (bi_pixel_indices) */
+   if (dim == GLSL_SAMPLER_DIM_SUBPASS_MS) {
+      nir_scalar sample = nir_scalar_resolved(intr->src[2].ssa, 0);
+
+      if (!nir_scalar_is_intrinsic(sample) ||
+          nir_scalar_intrinsic_op(sample) != nir_intrinsic_load_sample_id)
+         return false;
+   }
+
+   nir_variable *var = nir_deref_instr_get_variable(deref);
+   if (var == NULL)
+      return false;
+
+   unsigned index = var->data.index;
+   if (deref->deref_type == nir_deref_type_array) {
+      if (!nir_src_is_const(deref->arr.index))
+         return false;
+      index += nir_src_as_uint(deref->arr.index);
+   }
+
+   /* the fragment's own pixel: subpassLoad's offset is (0, 0) */
+   for (unsigned c = 0; c < 2; c++) {
+      nir_scalar s = nir_scalar_resolved(intr->src[1].ssa, c);
+
+      if (!nir_scalar_is_const(s) || nir_scalar_as_uint(s) != 0)
+         return false;
+   }
+
+   unsigned count = MIN2(ctx->rp->color_attachment_count, 8);
+   unsigned rt;
+   for (rt = 0; rt < count; rt++) {
+      if (ctx->ial->color_map[rt] == index)
+         break;
+   }
+   if (rt == count)
+      return false;
+
+   VkFormat vk_format = ctx->rp->color_attachment_formats[rt];
+   if (vk_format == VK_FORMAT_UNDEFINED)
+      return false;
+
+   enum glsl_base_type base = glsl_get_sampler_result_type(deref->type);
+   nir_alu_type type =
+      base == GLSL_TYPE_UINT  ? nir_type_uint
+      : base == GLSL_TYPE_INT ? nir_type_int
+                              : nir_type_float;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *value = nir_load_output(
+      b, intr->def.num_components, intr->def.bit_size, nir_imm_int(b, 0),
+      .base = 0, .range = 1, .component = 0,
+      .dest_type = type | intr->def.bit_size,
+      .io_semantics.location = FRAG_RESULT_DATA0 + rt,
+      .io_semantics.num_slots = 1);
+
+   nir_def_rewrite_uses(&intr->def, value);
+   nir_instr_remove(&intr->instr);
+   ctx->formats[rt] = vk_format_to_pipe_format(vk_format);
+   if (dim == GLSL_SAMPLER_DIM_SUBPASS_MS)
+      b->shader->info.fs.uses_sample_shading = true;
+   return true;
+}
+
+/* true when some input attachment is read from the tile buffer; `formats` the colour attachments' formats */
+static bool
+lower_tile_input_attachments(nir_shader *nir,
+                             const struct vk_graphics_pipeline_state *state,
+                             enum pipe_format formats[8])
+{
+   struct tile_inputs ctx = {0};
+
+   for (unsigned i = 0; i < 8; i++)
+      ctx.formats[i] = PIPE_FORMAT_NONE;
+   memcpy(formats, ctx.formats, sizeof(ctx.formats));
+   if (state == NULL || state->ial == NULL || state->rp == NULL)
+      return false;
+
+   ctx.ial = state->ial;
+   ctx.rp = state->rp;
+   bool progress = nir_shader_intrinsics_pass(
+      nir, lower_tile_input_attachment, nir_metadata_control_flow, &ctx);
+
+   memcpy(formats, ctx.formats, sizeof(ctx.formats));
+   return progress;
+}
