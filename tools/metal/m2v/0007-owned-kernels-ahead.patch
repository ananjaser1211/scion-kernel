 impl Device {
+    /// Scion: the kernel of `which` where it is made; else `None`, its making begun on a thread
+    /// of its own the first time (the owner's HITCH rule: nothing waits on the program's thread).
+    /// For a kernel a caller can do without until it is made: capture replay's (`render/capture.rs`),
+    /// which PanVK's compiler took a minute to make for the Astronomy wallpaper's first pass, on
+    /// the extension's main thread at its launch, so launchd killed it for not checking in, again
+    /// and again. A kernel the device cannot make stays `None`, its making not tried again.
+    pub(super) fn owned_kernel_ahead(&self, which: OwnedModule) -> Option<OwnedKernel> {
+        {
+            let mut kernels = lock(&self.shared().owned_kernels);
+            if let Some(kernel) = kernels.get(which) {
+                return Some(kernel);
+            }
+            if kernels.ahead.contains(&which) {
+                return None;
+            }
+            kernels.ahead.push(which);
+        }
+        let device = self.clone();
+        let builder = std::thread::Builder::new().name("metal2vulkan-owned-kernel".into());
+        let started = exit_guard::spawn(builder, move || {
+            // A making's turn, as the program's thread would take it, without the kernels' lock.
+            let _turn = crate::pipeline::budget::program_turn();
+            let made = which.build(&device).and_then(|(spirv, buffers, push_bytes)| {
+                let bindings = (which.images(), which.storage_images(), buffers);
+                make(&device, &spirv, bindings, push_bytes)
+            });
+            if let Ok(kernel) = made {
+                lock(&device.shared().owned_kernels).put(which, kernel);
+            }
+        });
+        if started.is_err() {
+            lock(&self.shared().owned_kernels).ahead.retain(|&w| w != which);
+        }
+        None
+    }
+
     /// The kernel of `which`, made on first use.
