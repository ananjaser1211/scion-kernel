+/// The format a color attachment of `pf` renders in on `profile` where it renders through the
+/// unsigned normalized view of its raw word (`LoweringInputs::extended_range_colors`,
+/// `pipeline::lower_inputs::UnormWrite`): `A2R10G10B10_UNORM_PACK32` for `BGR10_XR` and
+/// `BGR10_XR_sRGB` on a device that orders no framebuffer fetch (neither rasterization-order
+/// color attachment access nor the pixel interlock), where a blend into such an attachment has no
+/// other form, and that renders and blends the view's format. The view holds the word's bytes
+/// exactly as `R32_UINT` does: red's code in bits 20 to 29, green's in 10 to 19, blue's in 0 to
+/// 9 and Metal's two unused bits as alpha, so an unblended write of `c / 1023` stores Metal's code
+/// `c`, a clear Metal's texel, and a load and store keep every bit. Every pipeline and pass on the
+/// device renders such an attachment so, so that the pass and its pipelines agree on its format.
+/// `None` for every other format and device.
+pub fn unorm_codes_view(pf: PixelFormat, profile: &DeviceProfile) -> Option<vk::Format> {
+    let fragment = profile.fields().fragment;
+    let format = vk::Format::A2R10G10B10_UNORM_PACK32;
+    let renders = [FormatUsage::ColorAttachment, FormatUsage::ColorAttachmentBlend]
+        .into_iter()
+        .all(|usage| profile.supports_format(format, usage));
+    (matches!(ExtendedRange::of(pf), Some(ExtendedRange::Bgr10 { .. }))
+        && !fragment.rasterization_order_color_access
+        && !fragment.pixel_interlock
+        && renders)
+        .then_some(format)
+}
