+++ b/src/panfrost/vulkan/jm/panvk_vX_queue.c
@@ -29,6 +29,10 @@
 
 #include "drm-uapi/panfrost_drm.h"
 
+#ifdef __APPLE__
+#include <xf86drm.h> /* HAKIOS_DRM_BO_SAMPLED */
+#endif
+
 static void
 panvk_queue_submit_batch(struct panvk_queue *queue, struct panvk_batch *batch,
                          uint32_t *bos, unsigned nr_bos, uint32_t *in_fences,
@@ -219,6 +223,22 @@
    unsigned nr_semaphores = submit->wait_count + 1;
    uint32_t semaphores[nr_semaphores];
 
+#ifdef __APPLE__
+   /* The device's IOSurfaces as they are now (panvk_device.h: host_surfaces):
+    * each batch names those its own list does not as buffers it may read. */
+   simple_mtx_lock(&dev->host_surfaces.lock);
+   unsigned nr_surfaces = util_dynarray_num_elements(&dev->host_surfaces.bos,
+                                                     struct pan_kmod_bo *);
+   uint32_t surfaces[nr_surfaces ? nr_surfaces : 1];
+   for (unsigned i = 0; i < nr_surfaces; i++)
+      surfaces[i] = pan_kmod_bo_handle(*util_dynarray_element(
+         &dev->host_surfaces.bos, struct pan_kmod_bo *, i));
+   simple_mtx_unlock(&dev->host_surfaces.lock);
+#else
+   const unsigned nr_surfaces = 0;
+   uint32_t surfaces[1];
+#endif
+
    semaphores[0] = queue->sync;
    for (unsigned i = 0; i < submit->wait_count; i++) {
       assert(vk_sync_type_is_drm_syncobj(submit->waits[i].sync->type));
@@ -241,7 +261,7 @@
                            (batch->blit.dst ? 1 : 0) +
                            (batch->vtc_jc.first_tiler ? 1 : 0) + 1;
          unsigned bo_idx = 0;
-         uint32_t bos[nr_bos];
+         uint32_t bos[nr_bos + nr_surfaces];
 
          panvk_pool_get_bo_handles(&cmdbuf->desc_pool, &bos[bo_idx]);
          bo_idx += panvk_pool_num_bos(&cmdbuf->desc_pool);
@@ -277,6 +297,21 @@
             }
          }
 
+         /* An imported IOSurface the batch may sample: HakiosMali cleans
+          * what a processor wrote into it before the job (by its seed: a
+          * surface nobody wrote since is not cleaned again), keeps it until
+          * the job is done, and does not hold the display back for the job,
+          * which only reads it. */
+         unsigned nr_listed = nr_bos;
+         for (unsigned s = 0; s < nr_surfaces; s++) {
+            bool listed = false;
+
+            for (unsigned x = 0; x < nr_listed && !listed; x++)
+               listed = bos[x] == surfaces[s];
+            if (!listed)
+               bos[nr_bos++] = surfaces[s] | HAKIOS_DRM_BO_SAMPLED;
+         }
+
          unsigned nr_in_fences = 0;
          unsigned max_wait_event_syncobjs = util_dynarray_num_elements(
             &batch->event_ops, struct panvk_cmd_event_op);
