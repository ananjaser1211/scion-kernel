<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hakios.gnssd</string>
	<!-- the GNSS receiver (the BCM4775) for iOS: gnssd turns the receiver on while a position may be wanted (the
	     screen on, Location Services on), reads its fixes and hands them to locationd, which gives them to every app.
	     Without the receiver's firmware (devices/star2lte/firmware/gnss, gnss-esw-N-ADDR.bin in /redwood/fw) it says
	     so and waits, and locationd keeps to Wi-Fi. src/gnssd.m, docs/gnssd.md -->
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/gnssd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
