+/* Imported pages of the process's own (the cached type), not an IOSurface's:
+ * the Mali does not see them through the processors' caches. */
+static bool
+panvk_memory_host_cached(const struct panvk_device_memory *mem)
+{
+   return mem->vk.host_ptr != NULL && mem->vk.memory_type_index == 1;
+}
+
+/* Whether the kernel cleans and invalidates a buffer's lines for us
+ * (HakiosMali's request 0x7a): asked once, of no buffer, which a kernel with
+ * the request answers ENOENT and one without it ENOSYS. Without it, pages of
+ * the process's own are not imported: their lines could be kept only by this
+ * process's own DC CIVAC, which traps with the Exynos M3s up (0.67 us a line,
+ * slower than metal2vulkan's copy), as sys_dcache_flush() is a DSB alone. */
+static bool
+panvk_host_pages_syncable(int fd)
+{
+   static int syncable = -1;
+
+   if (p_atomic_read(&syncable) < 0) {
+      int ok = hakios_drm_sync(fd, 0, 0, 0) != 0 && errno == ENOENT;
+      p_atomic_set(&syncable, ok);
+   }
+   return p_atomic_read(&syncable) > 0;
+}
+
+/* Clean and invalidate the processors' lines of a range of such memory, by
+ * the kernel (hakios_drm_sync): what the host wrote goes out to memory for the
+ * GPU, and what the GPU wrote is read from memory, not from stale lines. */
+static void
+panvk_memory_host_sync(struct panvk_device *device, uint32_t count,
+                       const VkMappedMemoryRange *ranges)
+{
+   for (uint32_t i = 0; i < count; i++) {
+      VK_FROM_HANDLE(panvk_device_memory, mem, ranges[i].memory);
+
+      if (mem == NULL || !panvk_memory_host_cached(mem))
+         continue;
+
+      VkDeviceSize size = vk_device_memory_range(&mem->vk, ranges[i].offset,
+                                                 ranges[i].size);
+      ASSERTED int ret = hakios_drm_sync(device->kmod.dev->fd,
+                                         pan_kmod_bo_handle(mem->bo),
+                                         ranges[i].offset, size);
+      assert(ret == 0);
+   }
+}
+#endif
