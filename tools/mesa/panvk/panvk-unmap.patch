-      ASSERTED int ret = os_munmap(bo_base, pan_kmod_bo_size(bo));
+      ASSERTED int ret = pan_kmod_bo_munmap(bo, bo_base, pan_kmod_bo_size(bo));
       assert(!ret);
    }
 }
