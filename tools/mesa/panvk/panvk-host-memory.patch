+#ifdef __APPLE__
+struct pan_kmod_bo *
+pan_kmod_bo_import_user(struct pan_kmod_dev *dev, void *address, size_t size)
+{
+   struct pan_kmod_bo *bo = NULL;
+   struct pan_kmod_bo **slot;
+   uint32_t handle;
+
+   simple_mtx_lock(&dev->handle_to_bo.lock);
+
+   if (hakios_drm_user_memory(dev->fd, address, size, &handle))
+      goto err_unlock;
+
+   /* a new buffer every time: the kernel makes one for each request */
+   slot = util_sparse_array_get(&dev->handle_to_bo.array, handle);
+   if (!slot || *slot)
+      goto err_close_handle;
+
+   bo = dev->ops->bo_import(dev, handle, size, 0);
+   if (!bo)
+      goto err_close_handle;
+
+   *slot = bo;
+   simple_mtx_unlock(&dev->handle_to_bo.lock);
+   return bo;
+
+err_close_handle:
+   drmCloseBufferHandle(dev->fd, handle);
+
+err_unlock:
+   simple_mtx_unlock(&dev->handle_to_bo.lock);
+   return NULL;
+}
+#endif
+
