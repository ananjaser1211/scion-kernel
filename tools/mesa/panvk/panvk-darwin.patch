   dep_libdrm = null_dep
 endif
-if host_machine.system() == 'darwin' and (with_gallium_freedreno or with_gallium_panfrost or with_freedreno_vk)
+if host_machine.system() == 'darwin' and (with_gallium_freedreno or with_gallium_panfrost or with_freedreno_vk or with_panfrost_vk)
   # No DRM on this system: freedreno's requests go to the kernel's driver through a stand-in
   # for libdrm (src/hakios-drm, put there by Darwin on redwood's tools/mk-mesa.sh; its one
   # source file is built with freedreno's drm layer, src/freedreno/drm, or, without freedreno,
@@ -1725,6 +1725,12 @@
     include_directories : include_directories('src/hakios-drm'),
     link_args : ['-framework', 'IOKit', '-framework', 'CoreFoundation'],
   )
+  if with_panfrost_vk
+    # PanVK finds its GPU among the devices libdrm lists (vk_instance.c), which util/libdrm.h
+    # answers with "none" unless there is a libdrm: here the stand-in is one
+    # (tools/mesa/panvk/panvk-darwin.patch in Scion's repository)
+    pre_args += '-DHAVE_LIBDRM'
+  endif
 elif dep_libdrm.found()
   pre_args += '-DHAVE_LIBDRM'
   if with_dri_platform == 'drm' and with_dri
--- a/src/panfrost/vulkan/meson.build
+++ b/src/panfrost/vulkan/meson.build
@@ -34,6 +34,15 @@
   depend_files: u_trace_py,
 )
 
+# Mach-O has no undefined weak symbols that resolve to NULL at static link time, which the
+# entrypoint tables rely on (vk_entrypoints_gen.py, --weak): they are left to dyld, which binds a
+# weak reference it cannot find to NULL, as ELF does. tools/mk-panvk.sh (Scion) refuses a library
+# where anything but a weak reference is left so.
+panvk_darwin_link_args = []
+if host_machine.system() == 'darwin'
+  panvk_darwin_link_args = ['-Wl,-undefined,dynamic_lookup']
+endif
+
 libpanvk_files = files(
   'panvk_buffer.c',
   'panvk_cmd_pool.c',
