+  link_args : [ld_args_bsymbolic, ld_args_gc_sections, ld_args_build_id, panvk_darwin_link_args],
   install : true,
 )
 
--- a/src/panfrost/vulkan/panvk_instance.c
+++ b/src/panfrost/vulkan/panvk_instance.c
@@ -143,7 +143,38 @@
    const VkAllocationCallbacks *vkalloc = allocator->priv;
 
    return vk_free(vkalloc, data);
+}
+
+#ifdef __APPLE__
+#include <dlfcn.h>
+#include <mach-o/loader.h>
+
+/* The LC_UUID of the image this code is in, as the first 16 of 20 bytes (the rest zero). */
+static bool
+panvk_darwin_build_id(uint8_t sha[SHA1_DIGEST_LENGTH])
+{
+   Dl_info info;
+
+   memset(sha, 0, SHA1_DIGEST_LENGTH);
+   if (!dladdr((const void *)panvk_darwin_build_id, &info) || !info.dli_fbase)
+      return false;
+
+   const struct mach_header_64 *mh = info.dli_fbase;
+   if (mh->magic != MH_MAGIC_64)
+      return false;
+
+   const uint8_t *lc = (const uint8_t *)(mh + 1);
+   for (uint32_t i = 0; i < mh->ncmds; i++) {
+      const struct load_command *cmd = (const struct load_command *)lc;
+      if (cmd->cmd == LC_UUID) {
+         memcpy(sha, ((const struct uuid_command *)cmd)->uuid, 16);
+         return true;
+      }
+      lc += cmd->cmdsize;
+   }
+   return false;
 }
+#endif
 
