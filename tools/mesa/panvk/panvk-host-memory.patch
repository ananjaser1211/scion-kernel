+#ifdef __APPLE__
+VKAPI_ATTR VkResult VKAPI_CALL
+panvk_GetMemoryHostPointerPropertiesEXT(
+   VkDevice _device, VkExternalMemoryHandleTypeFlagBits handleType,
+   const void *pHostPointer,
+   VkMemoryHostPointerPropertiesEXT *pMemoryHostPointerProperties)
+{
+   VK_FROM_HANDLE(panvk_device, device, _device);
+
+   if (handleType != VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT)
+      return panvk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   /* the coherent type for an IOSurface's pages, the cached one for other
+    * whole pages of the process's own where the kernel keeps their lines
+    * (panvk_AllocateMemory) */
+   if (hakios_drm_host_surface_at(pHostPointer, 0) != 0)
+      pMemoryHostPointerProperties->memoryTypeBits = 1;
+   else if (((uintptr_t)pHostPointer & ((uintptr_t)getpagesize() - 1)) == 0 &&
+            panvk_host_pages_syncable(device->kmod.dev->fd))
+      pMemoryHostPointerProperties->memoryTypeBits = 2;
+   else
+      pMemoryHostPointerProperties->memoryTypeBits = 0;
+   return VK_SUCCESS;
+}
+#endif
