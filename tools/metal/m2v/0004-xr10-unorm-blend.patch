+/// An upper estimate of the SPIR-V words [`unorm_codes`] adds beside [`encode`]'s codes.
+pub const UNORM_WORDS: u32 = 40 * 6;
+
+/// What a write of `v` (a `vec4` of `f32`, red first, each lane a `half` value) to a
+/// `BGR10_XR` or `BGR10_XR_sRGB` attachment rendered through the `A2R10G10B10_UNORM_PACK32` view
+/// of its word writes as `write` writes it (`pipeline::lower_inputs::UnormWrite`): a `vec4` of
+/// `f32`, red, green and blue each a code over 1023, and alpha.
+///
+/// - Unblended (`Codes`): the codes Metal stores ([`encode`]'s, exact), and alpha 1, which the
+///   view stores as the word's two top bits set, as Metal writes them.
+/// - Blended: the code of the source as Metal's blend clamps it (each color channel to the codes
+///   0 and 1022, a NaN to the low end), of a linear form `384 + 510 v` unrounded and of an
+///   `_sRGB` one Metal's code of its encode, less the share of the bias 384 the source does not
+///   keep (none for `Over`, all for `Added`, one minus the alpha for `Premultiplied`), over 1023;
+///   alpha is the source's, clamped to `[0, 1]` (a NaN 0), which the source-alpha factors read
+///   and the pipeline's write mask keeps out of the word.
+pub(crate) fn unorm_codes(
+    fb: &mut FunctionBuilder<'_>,
+    form: ExtendedRange,
+    v: Value,
+    table: Option<GlobalId>,
+    write: UnormWrite,
+) -> BResult<Value> {
+    let f = floats();
+    let ft = crate::lower::arith::ops::ty(fb, f)?;
+    let f1 = fb.module().ty(Type::Float { width: 32 })?;
+    let zero = fsplat(fb, f, 0.0)?;
+    let codes = linear_codes(fb, form, v, table)?;
+    let codes = fb.convert(ConvOp::ConvertUToF, codes, ft)?;
+    let max = fsplat(fb, f, 1023.0)?;
+    if write == UnormWrite::Codes {
+        let u = fb.binary(BinOp::FDiv, codes, max)?;
+        let one = fsplat(fb, f, 1.0)?;
+        return fb.vector_shuffle(u, one, &[0, 1, 2, 7]);
+    }
+    let c = match form.srgb() {
+        true => codes,
+        false => {
+            let scale = fsplat(fb, f, 510.0)?;
+            let bias = fsplat(fb, f, 384.0)?;
+            let c = fb.binary(BinOp::FMul, v, scale)?;
+            fb.binary(BinOp::FAdd, c, bias)?
+        }
+    };
+    let nan = fb.unary(crate::spirv::ir::UnOp::IsNan, c)?;
+    let c = fb.select(nan, zero, c)?;
+    let top = fsplat(fb, f, 1022.0)?;
+    let c = fb.glsl(GlslOp::FClamp, &[c, zero, top])?;
+    // The source's alpha, clamped as Metal's blend clamps it.
+    let a = fb.composite_extract(v, &[3])?;
+    let a_nan = fb.unary(crate::spirv::ir::UnOp::IsNan, a)?;
+    let fzero = fb.module().constant(Constant::Scalar {
+        ty: f1,
+        bits: ConstBits(u64::from(0.0f32.to_bits())),
+    })?;
+    let fzero = fb.module().const_value(fzero)?;
+    let fone = fb.module().constant(Constant::Scalar {
+        ty: f1,
+        bits: ConstBits(u64::from(1.0f32.to_bits())),
+    })?;
+    let fone = fb.module().const_value(fone)?;
+    let a = fb.select(a_nan, fzero, a)?;
+    let a = fb.glsl(GlslOp::FClamp, &[a, fzero, fone])?;
+    let c = match write {
+        UnormWrite::Codes | UnormWrite::Over => c,
+        UnormWrite::Added => {
+            let bias = fsplat(fb, f, 384.0)?;
+            fb.binary(BinOp::FSub, c, bias)?
+        }
+        UnormWrite::Premultiplied => {
+            // 384 (1 - a) left out.
+            let k = fb.module().constant(Constant::Scalar {
+                ty: f1,
+                bits: ConstBits(u64::from(384.0f32.to_bits())),
+            })?;
+            let k = fb.module().const_value(k)?;
+            let kept = fb.binary(BinOp::FSub, fone, a)?;
+            let off = fb.binary(BinOp::FMul, kept, k)?;
+            let off = fb.composite_construct(ft, &[off, off, off, fzero])?;
+            fb.binary(BinOp::FSub, c, off)?
+        }
+    };
+    let u = fb.binary(BinOp::FDiv, c, max)?;
+    let r = fb.composite_extract(u, &[0])?;
+    let g = fb.composite_extract(u, &[1])?;
+    let b = fb.composite_extract(u, &[2])?;
+    fb.composite_construct(ft, &[r, g, b, a])
+}
