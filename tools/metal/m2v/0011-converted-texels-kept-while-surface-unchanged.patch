@@ -0,0 +1,182 @@
+//! Scion: converted texels kept while their surface is unchanged (tools/metal/m2v/).
+//!
+//! A two-plane YCbCr texture over an IOSurface is an image of the texels Metal reads of its planes
+//! (`ycbcr.rs`), which an encoder converts again before its first command that uses the texture.
+//! The window server samples the home screen's wallpaper so at every frame, and its conversion was
+//! 9.4 ms of the Mali-G72's 16 ms a frame (docs/metal.md, phase 7). Its planes never change.
+//!
+//! - **What tells a change.** The surface's seed (`IOSurfaceGetSeed`), which the system changes at
+//!   each lock and unlock for writing by the CPU, and which Scion's kernel also changes as the video
+//!   decoder writes a frame into a surface and as a GPU job of a process that does not announce its
+//!   own writes is queued (HakiosMali). This runtime announces its own GPU writes of a watched
+//!   surface after their batch is submitted ([`SurfaceWatch::written`]), so other processes see
+//!   them, and it forgets the conversions over the bytes it wrote, so it sees them itself. The
+//!   frontend gives the seed and the announcement of a surface's buffer ([`Buffer::watch_surface`]);
+//!   a texture over a buffer no one watches converts at every encoder, as before.
+//! - **Where it is decided.** An encoder's first use of such a texture records no conversion where
+//!   no command of its command buffer before it wrote the planes' bytes (`shadow.rs`, `elided`);
+//!   the texture is noted with the command buffer instead. As the command buffer's first batch is
+//!   submitted, in the queue's order, each noted texture whose image does not hold the planes as of
+//!   the seed read then is converted, in a command buffer of its own at the batch's start, between
+//!   two barriers from and to every command (`command_buffer/submit.rs`). A use after a write of the
+//!   planes in the same command buffer converts in the encoder, as before.
+//! - **What an image holds** ([`Held`]): the seed its last conversion at a batch's start read, and
+//!   the `VkQueue` it ran on; forgotten once a batch writes the image (a conversion in an encoder, a
+//!   function's write Metal drops) or the planes' bytes. A texture used on another `VkQueue` than its
+//!   last conversion's converts again.
+//! - **What the seed does not tell**: a CPU write of the surface's pixels without the lock IOSurface
+//!   asks for. The frontend takes the lock around the writes it makes for the program
+//!   (`replaceRegion:` of a texture over a surface).
+//!
+//! Patch for Scion (tools/metal/m2v/), under metal2vulkan's licence.
+
+use super::device::lock;
+use super::resource::ResourceKey;
+use super::shadow::ShadowCopies;
+use std::collections::HashMap;
+use std::ffi::c_void;
+use std::sync::{Arc, Mutex, Weak};
+
+/// The frontend's view of an IOSurface: its seed, and the announcement of a GPU write of its
+/// pixels (both called on any thread, with `context`).
+pub struct SurfaceWatch {
+    seed: unsafe extern "C" fn(*mut c_void) -> u32,
+    written: Option<unsafe extern "C" fn(*mut c_void)>,
+    context: Context,
+}
+
+struct Context(*mut c_void);
+// SAFETY: the frontend's contract (`SurfaceWatch::new`): its calls take the context on any thread.
+unsafe impl Send for Context {}
+// SAFETY: as above.
+unsafe impl Sync for Context {}
+
+impl SurfaceWatch {
+    /// A surface's watch: `seed(context)` answers the surface's seed now, `written(context)`
+    /// announces that work this process submitted writes its pixels.
+    ///
+    /// # Safety
+    ///
+    /// Both calls are safe on any thread with `context` for as long as the buffer the watch is
+    /// given to lives (the frontend's surface import, which holds the surface until then).
+    pub unsafe fn new(
+        seed: unsafe extern "C" fn(*mut c_void) -> u32,
+        written: Option<unsafe extern "C" fn(*mut c_void)>,
+        context: *mut c_void,
+    ) -> SurfaceWatch {
+        SurfaceWatch {
+            seed,
+            written,
+            context: Context(context),
+        }
+    }
+
+    /// The surface's seed now.
+    pub(super) fn seed(&self) -> u32 {
+        // SAFETY: the contract of `new`.
+        unsafe { (self.seed)(self.context.0) }
+    }
+
+    /// Announce a GPU write of the surface's pixels, once its batch is submitted.
+    pub(super) fn written(&self) {
+        if let Some(written) = self.written {
+            // SAFETY: the contract of `new`.
+            unsafe { written(self.context.0) }
+        }
+    }
+}
+
+/// What a converted image holds as of the batches submitted so far (the module's rules).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Held {
+    /// The seed the conversion read.
+    pub(super) seed: u32,
+    /// The `VkQueue` it ran on.
+    pub(super) queue: usize,
+    /// The planes' buffer's key, and the key of the host memory it joined.
+    truth: (ResourceKey, Option<ResourceKey>),
+}
+
+impl Held {
+    pub(super) fn new(
+        seed: u32,
+        queue: usize,
+        truth: ResourceKey,
+        alias: Option<ResourceKey>,
+    ) -> Held {
+        Held {
+            seed,
+            queue,
+            truth: (truth, alias),
+        }
+    }
+}
+
+/// The device's watched surfaces and converted images (the module's rules).
+#[derive(Default)]
+pub(super) struct SurfaceWatches {
+    /// The watch of each surface buffer by its key (and its host memory's), while it lives.
+    watched: Mutex<HashMap<ResourceKey, Weak<SurfaceWatch>>>,
+    /// What each converted image holds, by the image's key, while its texture's copies live.
+    held: Mutex<HashMap<ResourceKey, (Held, Weak<ShadowCopies>)>>,
+}
+
+impl SurfaceWatches {
+    /// Note `watch` as the watch of the buffer of `keys`.
+    pub(super) fn watch(&self, keys: impl IntoIterator<Item = ResourceKey>, watch: &Arc<SurfaceWatch>) {
+        let mut watched = lock(&self.watched);
+        watched.retain(|_, held| held.strong_count() > 0);
+        for key in keys {
+            watched.insert(key, Arc::downgrade(watch));
+        }
+    }
+
+    /// What image `image` holds, where a batch's start converted it.
+    pub(super) fn held(&self, image: ResourceKey) -> Option<Held> {
+        lock(&self.held).get(&image).map(|(held, _)| *held)
+    }
+
+    /// A batch submitted: the conversions it ran at its start (`converted`), then every key its
+    /// commands wrote (`written`): an image written is forgotten, as is every image over bytes
+    /// written, and each watched surface written is announced.
+    pub(super) fn submitted(
+        &self,
+        converted: impl IntoIterator<Item = (ResourceKey, Held, Weak<ShadowCopies>)>,
+        written: &[ResourceKey],
+    ) {
+        {
+            let mut held = lock(&self.held);
+            held.extend(
+                converted
+                    .into_iter()
+                    .map(|(image, h, copies)| (image, (h, copies))),
+            );
+            // An image whose texture went is forgotten too (keys are never reused).
+            held.retain(|image, (h, copies)| {
+                copies.strong_count() > 0
+                    && !written.iter().any(|key| {
+                        key == image || *key == h.truth.0 || Some(*key) == h.truth.1
+                    })
+            });
+        }
+        if written.is_empty() {
+            return;
+        }
+        let watches: Vec<Arc<SurfaceWatch>> = {
+            let watched = lock(&self.watched);
+            if watched.is_empty() {
+                return;
+            }
+            let mut found: Vec<Arc<SurfaceWatch>> = Vec::new();
+            for watch in written.iter().filter_map(|key| watched.get(key)?.upgrade()) {
+                if !found.iter().any(|seen| Arc::ptr_eq(seen, &watch)) {
+                    found.push(watch);
+                }
+            }
+            found
+        };
+        for watch in watches {
+            watch.written();
+        }
+    }
+}
