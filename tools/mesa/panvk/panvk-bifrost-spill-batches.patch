 /* If register allocation fails, find the best spill node */
 
-static signed
-bi_choose_spill_node(bi_context *ctx, struct lcra_state *l)
+/* Scion: register allocation spills in batches (bi_register_allocate) */
+#define BI_SPILL_RAMP      8
+#define BI_SPILL_BATCH_MAX 64
+
+/* Scion: the candidate with the most constraints first; equal ones in node
+ * order, as the single choice took the first of them. */
+struct bi_spill_choice {
+   unsigned benefit;
+   unsigned node;
+};
+
+static void
+bi_keep_spill_choice(struct bi_spill_choice *best, unsigned *count,
+                     unsigned max, unsigned node, unsigned benefit)
+{
+   unsigned at = *count;
+
+   if (at == max) {
+      if (benefit <= best[max - 1].benefit)
+         return;
+      at = max - 1;
+   } else {
+      (*count)++;
+   }
+
+   while (at > 0 && best[at - 1].benefit < benefit) {
+      best[at] = best[at - 1];
+      at--;
+   }
+
+   best[at] = (struct bi_spill_choice){benefit, node};
+}
+
+/* Up to `max` nodes to spill, best first, into `nodes`: their number. */
+static unsigned
+bi_choose_spill_nodes(bi_context *ctx, struct lcra_state *l, signed *nodes,
+                      unsigned max)
 {
