+/// How a fragment function writes attachment `c` on `p` where it renders through the unsigned
+/// normalized view of its word (`metal::format::unorm_codes_view`): unblended, its codes; blended,
+/// added, by the share of the codes' bias the source keeps (`UnormWrite`), for the factors that
+/// keep a share the function can write: those that read neither the destination, nor the source's
+/// color (the function writes codes there, not Metal's value), nor a second output. `None` where
+/// the attachment holds its raw word, and for every other blend, which stays refused
+/// (`NotImplemented(Format)`).
+pub(crate) fn unorm_write(c: &ColorAttachmentDescriptor, p: &DeviceProfile) -> Option<UnormWrite> {
+    use metal::BlendFactor as F;
+    metal::format::unorm_codes_view(c.pixel_format, p)?;
+    if !c.blending_enabled {
+        return Some(UnormWrite::Codes);
+    }
+    if c.rgb_blend_operation != metal::BlendOperation::Add {
+        return None;
+    }
+    let source = c.source_rgb_blend_factor;
+    let constant = matches!(
+        source,
+        F::Zero | F::One | F::SourceAlpha | F::BlendColor | F::BlendAlpha
+    );
+    match (source, c.destination_rgb_blend_factor) {
+        (F::SourceAlpha, F::OneMinusSourceAlpha)
+        | (F::BlendColor, F::OneMinusBlendColor)
+        | (F::BlendAlpha, F::OneMinusBlendAlpha)
+        | (F::One, F::Zero) => Some(UnormWrite::Over),
+        (F::One, F::OneMinusSourceAlpha) => Some(UnormWrite::Premultiplied),
+        (_, F::One) if constant => Some(UnormWrite::Added),
+        _ => None,
+    }
+}
