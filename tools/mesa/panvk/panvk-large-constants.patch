+/* load_constant (nir_opt_large_constants) as a load from the shader's constant
+ * data, whose address is a sysval */
+static bool
+lower_load_constant(struct nir_builder *b, nir_intrinsic_instr *intr,
+                    UNUSED void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_constant)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   nir_def *base = b->shader->info.stage == MESA_SHADER_COMPUTE
+                      ? load_sysval(b, compute, 64, const_data)
+                      : load_sysval(b, graphics, 64, const_data);
+   nir_def *offset =
+      nir_iadd_imm(b, intr->src[0].ssa, nir_intrinsic_base(intr));
+   unsigned align = nir_combined_align(nir_intrinsic_align_mul(intr),
+                                       nir_intrinsic_align_offset(intr));
+   nir_def *value = nir_load_global_constant(
+      b, nir_iadd(b, base, nir_u2u64(b, offset)), align,
+      intr->def.num_components, intr->def.bit_size);
+
+   nir_def_replace(&intr->def, value);
+   return true;
+}
+
 static void
 panvk_lower_nir(struct panvk_device *dev, nir_shader *nir,
                 uint32_t set_layout_count,
